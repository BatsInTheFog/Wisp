# ---- ESP-IDF builds ----
build/
build-*/
sdkconfig
sdkconfig.old
# keep sdkconfig.defaults (it is the tracked source of build settings)
!sdkconfig.defaults
!sdkconfig.defaults.*
managed_components/
dependencies.lock

# ---- PlatformIO ----
.pio/
.pioenvs/
.piolibdeps/
.vscode/.browse.c_cpp.db*
.vscode/c_cpp_properties.json
.vscode/launch.json
.vscode/ipch

# ---- Flash images and dumps ----
# Never commit firmware binaries or flash backups (they can hold Wi-Fi
# passwords and device keys read off the board).
*.bin
*.elf
*.map
*.uf2
flash_backup*/

# ---- Hermes Gadget simulator ----
build/host/
.hermes-gadget/

# ---- Reference checkouts (clone other projects here, read-only) ----
third_party/_refs/

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
*.egg-info/

# ---- Secrets and local settings ----
.env
.env.*
!.env.example
secrets.h
*_secrets.h
wifi_credentials*

# ---- Editors and OS ----
.idea/
*.swp
*~
.DS_Store
Thumbs.db
desktop.ini
